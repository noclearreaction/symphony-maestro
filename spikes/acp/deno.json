{
  "name": "@symphony/acp-spike",
  "version": "0.0.0",
  "license": "MIT",
  "exports": "./main.ts",
  "tasks": {
    "spike": "deno run --allow-run --allow-read --allow-env main.ts",
    "check": "deno check main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@agentclientprotocol/sdk": "npm:@agentclientprotocol/sdk@1.3.0"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
